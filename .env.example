# Google Gemini API Key for AI Architecture Explanation & Graph Code-RAG
# Get your free key at: https://aistudio.google.com/app/apikey
# Note: If left blank, TraceFlow Map automatically uses deterministic AST heuristics!
GEMINI_API_KEY=

# Backend Server Configuration
# Using port 8005 to avoid collisions with default port 8000
PORT=8005
HOST=0.0.0.0

# Ingestion Constraints (Demo safety)
MAX_FILES=400
MAX_FILE_SIZE_BYTES=1048576

